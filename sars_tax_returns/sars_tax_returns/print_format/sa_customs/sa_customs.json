{
 "align_labels_right": 0,
 "creation": "2026-11-21 13:30:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Customs VAT Schedule",
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div class=\"sheet\">\n<style>\n  @page { size: A4; margin: 14mm 13mm 16mm 13mm; }\n  * { box-sizing: border-box; }\n  body { font-family: Helvetica, Arial, sans-serif; color: #14213d; font-size: 10.5px; line-height: 1.35; }\n  .sheet { width: 100%; }\n  .masthead { border-bottom: 2.5px solid #14213d; display: flex; justify-content: space-between; gap: 18px; padding-bottom: 10px; margin-bottom: 12px; }\n  .kicker { color: #1b6ef3; font-size: 9px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; margin-bottom: 3px; }\n  h1 { font-size: 22px; line-height: 1.15; margin: 0 0 3px; }\n  .subtitle { color: #5b6b80; font-size: 10px; }\n  .doc-meta { text-align: right; color: #5b6b80; font-size: 9.5px; min-width: 145px; }\n  .doc-meta b { color: #14213d; font-size: 11px; }\n  .grid { display: table; width: 100%; border-collapse: collapse; margin-bottom: 10px; }\n  .grid .row { display: table-row; }\n  .grid .cell { display: table-cell; padding: 4px 8px 4px 0; vertical-align: top; }\n  .label { color: #5b6b80; font-size: 8.5px; text-transform: uppercase; letter-spacing: .5px; }\n  .value { font-size: 11px; font-weight: 600; }\n  .box { border: 1px solid #d7e0ea; border-radius: 6px; padding: 10px 12px; margin-bottom: 10px; background: #f8fafc; }\n  .box h2 { font-size: 11px; margin: 0 0 7px; text-transform: uppercase; letter-spacing: .7px; }\n  table { width: 100%; border-collapse: collapse; margin: 5px 0 10px; }\n  th { background: #eef3f8; color: #14213d; font-size: 8.5px; text-align: left; padding: 6px 6px; border-bottom: 1px solid #c9d6e2; text-transform: uppercase; letter-spacing: .4px; }\n  td { padding: 5px 6px; border-bottom: 1px solid #e3eaf2; vertical-align: top; }\n  td.num, th.num { text-align: right; white-space: nowrap; }\n  tr.total td { font-weight: 700; background: #f4f7fb; border-top: 2px solid #14213d; }\n  .metric { display: table; width: 100%; border-collapse: separate; border-spacing: 7px 0; margin: 0 -7px 8px; }\n  .metric .m { display: table-cell; width: 25%; border: 1px solid #d7e0ea; border-radius: 6px; padding: 9px 10px; background: #fff; }\n  .metric .m .label { margin-bottom: 4px; }\n  .metric .m .value { font-size: 14px; }\n  .note { color: #5b6b80; font-size: 9px; line-height: 1.4; }\n  .disclaimer { border-top: 1px solid #d7e0ea; margin-top: 12px; padding-top: 7px; color: #5b6b80; font-size: 8.5px; }\n  .pill { display: inline-block; border: 1px solid #c9d6e2; border-radius: 20px; padding: 1px 7px; font-size: 8.5px; color: #5b6b80; }\n  .avoid { page-break-inside: avoid; }\n  .action-banner, .print-hide { display: none !important; }\n  .date { white-space: nowrap; }\n  .customs-table td:nth-child(2), .customs-table th:nth-child(2),\n  .customs-table td:nth-child(3), .customs-table th:nth-child(3) { white-space: nowrap; }\n</style>\n\n<div class=\"masthead\">\n  <div>\n    <div class=\"kicker\">SARS Tax Returns · Working Paper</div>\n    <h1>Customs VAT Schedule</h1>\n    <div class=\"subtitle\">Customs value, import VAT and diesel refund working paper</div>\n  </div>\n  <div class=\"doc-meta\">\n    <div><b>{{ doc.name }}</b></div>\n    <div>{{ doc.status }}</div>\n    <div>{{ doc.company }}</div>\n  </div>\n</div>\n\n<div class=\"grid\">\n  <div class=\"row\"><div class=\"cell\"><div class=\"label\">Period</div><div class=\"value\">{{ frappe.format(doc.period_start, {\"fieldtype\": \"Date\"}) if doc.period_start else \"\" }} – {{ frappe.format(doc.period_end, {\"fieldtype\": \"Date\"}) if doc.period_end else \"\" }}</div></div>\n  <div class=\"cell\"><div class=\"label\">Lines</div><div class=\"value\">{{ doc.lines|length }}</div></div></div>\n</div>\n\n<table class=\"customs-table\">\n  <thead><tr><th>Type</th><th>Document</th><th>Date</th><th class=\"num\">Customs Value</th><th class=\"num\">Duty</th><th class=\"num\">Import VAT</th><th class=\"num\">Diesel L</th><th class=\"num\">Diesel Refund</th></tr></thead>\n  <tbody>\n  {% for row in doc.lines %}\n    <tr><td>{{ row.entry_type }}</td><td>{{ row.document_no }}</td><td>{{ frappe.format(row.posting_date, {\"fieldtype\": \"Date\"}) if row.posting_date else \"\" }}</td><td class=\"num\">{{ frappe.format(row.customs_value or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td><td class=\"num\">{{ frappe.format(row.customs_duty or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td><td class=\"num\">{{ frappe.format(row.import_vat or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td><td class=\"num\">{{ \"%.2f\"|format(row.diesel_litres or 0) }}</td><td class=\"num\">{{ frappe.format(row.diesel_refund or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td></tr>\n  {% endfor %}\n  </tbody>\n  <tfoot><tr class=\"total\"><td colspan=\"3\">Totals</td><td class=\"num\">{{ frappe.format(doc.total_customs_value or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td><td class=\"num\">{{ frappe.format(doc.total_customs_duty or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td><td class=\"num\">{{ frappe.format(doc.total_import_vat or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td><td class=\"num\">{{ \"%.2f\"|format(doc.total_diesel_litres or 0) }}</td><td class=\"num\">{{ frappe.format(doc.total_diesel_refund or 0, {\"fieldtype\": \"Currency\", \"options\": \"ZAR\"}) }}</td></tr></tfoot>\n</table>\n\n<div class=\"note\">Import VAT may support VAT201 Field 14A/15A. Customs duty and diesel refunds remain subject to customs and VAT264 eligibility.</div>\n{% if doc.notes %}<div class=\"box avoid\"><h2>Notes</h2><div class=\"note\">{{ doc.notes }}</div></div>{% endif %}\n\n<div class=\"disclaimer\">\n  This is a customs VAT working paper, not a customs declaration or SARS submission.\n  <b>Working paper only.</b> This document is not a SARS eFiling submission and does not replace the official return.\n  A tax practitioner must review the figures, evidence and legal treatment before filing.\n</div>\n</div>\n</div>",
 "idx": 0,
